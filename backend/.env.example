# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Secret (generate a random string for production)
SESSION_SECRET=your-session-secret-here

# JWT Secret (generate a random string for production)
JWT_SECRET=your-jwt-secret-here

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: path to service account JSON (falls back to Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Resend API Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Upstash Redis (optional — caching degrades gracefully without it)
# Get from: https://upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# Admin email domain allowlist (optional — comma-separated, for defense-in-depth)
# ADMIN_EMAIL_DOMAINS=yourdomain.com

# BullMQ — ioredis TCP connection (required for job queues)
# Get from: https://upstash.com → your DB → ioredis connection string
REDIS_URL=rediss://default:TOKEN@HOST:PORT

# Admin secret for Bull Board dashboard (required in production)
ADMIN_SECRET=your-admin-secret-here

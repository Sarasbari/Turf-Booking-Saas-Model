rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if user is an approved owner of a specific turf ──
    function isOwnerOfTurf(turfId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.turfId == turfId
        && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.isApproved == true;
    }

    // ── Turfs: public read, only owner of that turf can update ──
    match /turf/{turfId} {
      allow read: if true;
      allow update: if isOwnerOfTurf(turfId);
      allow create, delete: if false;

      // Reviews: public read, authenticated users can create their own
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    // ── Bookings: BACKEND WRITES ONLY via Admin SDK (bypasses rules) ──
    // Clients can NEVER write bookings directly.
    // Read allowed for the booking's owner or the turf owner.
    match /bookings/{bookingId} {
      allow write: if false; // Admin SDK bypasses this — backend-only writes
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || isOwnerOfTurf(resource.data.turfId));
    }

    // ── User profiles: own data only ──
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Owner profiles: own data only, cannot self-approve ──
    match /owners/{ownerId} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow create: if request.auth != null && request.auth.uid == ownerId;
      allow update: if request.auth != null && request.auth.uid == ownerId
        && !('isApproved' in request.resource.data
             && request.resource.data.isApproved != resource.data.isApproved);
      allow delete: if false;
    }

    // ── Blocked slots: public read, user can lock/unlock own slots,
    //    turf owner can also delete (clear stale locks) ──
    match /blockedSlots/{slotId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.blockedBy == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.blockedBy == request.auth.uid
            || isOwnerOfTurf(resource.data.turfId));
    }

    // ── Payments: server-only (deny all client access) ──
    match /payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
